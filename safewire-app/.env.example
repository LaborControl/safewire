# =============================================================================
# SAFEWIRE Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# For local development, use docker compose up -d to start PostgreSQL

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Local development: postgresql://safewire:safewire_dev@localhost:5432/safewire
# Production: Get from Scaleway Managed Database Console
DATABASE_URL=postgresql://safewire:safewire_dev@localhost:5432/safewire

# =============================================================================
# Application
# =============================================================================
APP_URL=http://localhost:3000

# =============================================================================
# NextAuth.js
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars

# GitHub OAuth (from starter - will be replaced with Magic Link in Story 0.5)
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# =============================================================================
# Stripe (from starter - may be removed if not needed)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET_KEY=whsec_xxx
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# =============================================================================
# Scaleway Object Storage (S3-compatible)
# =============================================================================
# Create API key in Scaleway Console: https://console.scaleway.com/iam/api-keys
# Required permissions: ObjectStorageFullAccess
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Bucket name (create in Console): safewire-documents-dev
SCW_BUCKET=safewire-documents-dev
# Region and endpoint (Paris for RGPD compliance)
SCW_REGION=fr-par
SCW_ENDPOINT=https://s3.fr-par.scw.cloud

# =============================================================================
# Scaleway Container Registry (for CI/CD - Story 0.3)
# =============================================================================
# Registry endpoint: rg.fr-par.scw.cloud/safewire
SCW_REGISTRY=rg.fr-par.scw.cloud/safewire

# =============================================================================
# Email - Resend (Story 0.5)
# =============================================================================
RESEND_API_KEY=
